bindAddr = "0.0.0.0"
bindPort = ${FRP_BIND_PORT}

vhostHTTPPort = 8080
vhostHTTPSPort = 8443

webServer.addr = "127.0.0.1"
webServer.port = 7500
webServer.user = "root"
webServer.password = "${FRP_WEB_PASSWORD}"

log.to = "./frps.log"
log.level = "info"
log.maxDays = 3

auth.method = "token"
auth.token = "${FRP_TOKEN}"
